# Server only. Never expose this to the browser.
CURSOR_API_KEY=cursor_...

# GitHub repo connected to your Cursor account.
# examples/acme defaults this to https://github.com/ericzakariasson/feedback-agent
FEEDBACK_REPO_URL=https://github.com/ericzakariasson/feedback-agent
# Optional. examples/acme falls back to the current git branch.
FEEDBACK_REPO_REF=main

# Local + Next examples default to dry-run unless this is false.
# The Acme recording demo (examples/acme) is LIVE unless this is true.
FEEDBACK_DRY_RUN=true
