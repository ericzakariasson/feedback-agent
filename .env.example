# Copy to .env.local for local runs. `agent-sdk slack create` writes the Slack
# tokens there for you without printing them.

# Slack app (Socket Mode). Bot token starts with xoxb-, app-level token with xapp-.
FEEDBACK_AGENT_SLACK_BOT_TOKEN=
FEEDBACK_AGENT_SLACK_APP_TOKEN=

# Repository the cloud agent fixes. Defaults live in bot/lib/config.ts.
FEEDBACK_REPO_URL=https://github.com/ericzakariasson/feedback-agent
FEEDBACK_REPO_REF=main

# Optional. `agent-sdk login` is enough locally; set this only for CI or a
# headless host. Hosted deployments run under their service account instead.
# CURSOR_API_KEY=
